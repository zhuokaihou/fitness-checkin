PUBLIC_URL=http://127.0.0.1:8080
SECURE_COOKIE=false
# Production: set PUBLIC_URL=https://fitness.example.com and SECURE_COOKIE=true
# Comma separated exact trusted public HTTPS hosts; never include internal hosts.
LLM_ALLOWED_HOSTS=api.openai.com
# Used by the HTTPS compose override only; replace with your real domain.
SITE_DOMAIN=fitness.example.com
ACME_EMAIL=admin@example.com
